# StayOps environment — copy to `.env` in the repo root and fill in.
# `.env` is gitignored. Never commit real values.
# Both apps/api and apps/web read this single root file.

# ---------------------------------------------------------------------------
# Supabase project (Dashboard → Project Settings → API / API Keys)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or legacy "anon" key. Safe for browsers.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
# Secret key (sb_secret_...) or legacy "service_role" key. SERVER ONLY.
# Only used by the seed script to create the demo auth user. Optional otherwise.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
# Legacy HS256 JWT secret (Project Settings → JWT Keys → Legacy JWT secret).
# Optional: the API verifies asymmetric tokens via the project's JWKS endpoint
# and only falls back to this for HS256-signed tokens.
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Database (Dashboard → Connect → "Session pooler" connection string).
# Use the session pooler (port 5432 on *.pooler.supabase.com): it supports IPv4
# and prepared statements. Keep the postgresql+psycopg:// prefix.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres
# Optional. Tests create and drop a disposable schema here.
# Defaults to DATABASE_URL (tests never touch the `public` schema).
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of exact allowed origins (no wildcards).
API_CORS_ORIGINS=http://localhost:3000
# Optional; architecturally supported, unused in Phase 1.
REDIS_URL=

# Operations (defaults shown). A turnover shorter than this is "tight".
TIGHT_TURNOVER_MINUTES=180
# When true a completed cleaning waits for inspection before the unit is ready.
CLEANING_REQUIRES_INSPECTION=true
# Outbox worker (see docs/worker.md). Unset = embedded in the API in development only;
# set EVENT_WORKER_EMBEDDED=false on API nodes when running `pnpm` worker separately.
EVENT_MAX_ATTEMPTS=8
EVENT_LEASE_SECONDS=300

# ---------------------------------------------------------------------------
# Web (NEXT_PUBLIC_* are exposed to the browser)
# NEXT_PUBLIC_SUPABASE_URL / _PUBLISHABLE_KEY default to the SUPABASE_* values
# above if left empty.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Seed / E2E demo login (dev project only)
# ---------------------------------------------------------------------------
SEED_DEMO_EMAIL=demo@stayops.dev
SEED_DEMO_PASSWORD=change-me-dev-password

# ---------------------------------------------------------------------------
# AI (Phase 5) — see docs/ai.md
# ---------------------------------------------------------------------------
# disabled (default): no agent answers guests or runs Copilot.
# mock: deterministic in-process provider (tests, evals, demos; no network, no cost).
# openai: OpenAI Chat Completions with tool calling.
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Cost estimates in USD per million tokens (set your provider's current prices).
AI_INPUT_COST_PER_MTOK=0.40
AI_OUTPUT_COST_PER_MTOK=1.60

# ---------------------------------------------------------------------------
# Autopilot (Phase 6) — see docs/automations.md
# ---------------------------------------------------------------------------
# How often the worker evaluates scheduled triggers (seconds).
AUTOMATION_SCHEDULE_INTERVAL_SECONDS=60
# Executions claimed per worker pass; automatic retries of unexpected errors;
# operator retries allowed per failed execution.
AUTOMATION_BATCH_SIZE=20
AUTOMATION_MAX_AUTO_ATTEMPTS=3
AUTOMATION_MAX_MANUAL_RETRIES=5
